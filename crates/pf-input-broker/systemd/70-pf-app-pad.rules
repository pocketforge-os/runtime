# Stable node for the broker's App Pad virtual gamepad (see pad_uinput_spec(App) in uinput.rs:
# name "PocketForge App Pad", BUS_VIRTUAL, vendor 0x5046, product 0x0100).
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="PocketForge App Pad", ATTRS{id/vendor}=="5046", ATTRS{id/product}=="0100", SYMLINK+="input/pf-app-pad"
