[Unit]
Description=PocketForge system volume preference applier
Wants=pf-prefsd.service pocketforge-audio-defaults.service
After=pf-prefsd.service pocketforge-audio-defaults.service sound.target

[Service]
Type=simple
ExecStart=/usr/bin/pf-volumed
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=char-alsa rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
